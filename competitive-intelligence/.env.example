# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit it (spec §2).
#
#   cp .env.example .env
#   # then paste your token below
#
# Get a token from https://console.apify.com/account/integrations

APIFY_TOKEN=your_apify_token_here

# Hard spend cap in USD for a single run. The scrapers refuse to start a run
# whose estimated cost would exceed this (spec §2). Must be set before Step 1.
SOS_SPEND_CAP_USD=
